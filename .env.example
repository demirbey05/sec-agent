# The model decides which key is needed. Set only the one you use.
#
# OpenRouter — free models such as `openai/gpt-oss-120b` live here.
OPENROUTER_API_KEY=sk-or-v1-...

# Anthropic — needed only for a `anthropic:` model.
# ANTHROPIC_API_KEY=sk-ant-...

# Agent settings (optional — defaults live in src/sec_agent/settings.py)
# SEC_AGENT_MODEL=openrouter:openai/gpt-oss-120b
# SEC_AGENT_MODEL=anthropic:claude-opus-5
# SEC_AGENT_EFFORT=high
# SEC_AGENT_MAX_TOKENS=16000
# SEC_AGENT_RETRIES=2

# Elasticsearch the triage tools query
# SEC_AGENT_ES_URL=http://localhost:9200
